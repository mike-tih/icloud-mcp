# ---- iCloud credentials -----------------------------------------------------
# Used when the request carries no credentials (stdio mode / single-user server).
# Generate an app-specific password at https://account.apple.com/account/manage
ICLOUD_EMAIL=your-email@icloud.com
ICLOUD_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Calendar ---------------------------------------------------------------
# IANA timezone used for naive start/end values. Default: the machine's zone (or UTC).
# Set it explicitly on servers, e.g. Europe/Berlin
#DEFAULT_TIMEZONE=Europe/Berlin

# ---- Mail -------------------------------------------------------------------
# Max characters of an email body returned to the model (HTML is rendered to text first)
#EMAIL_BODY_MAX_CHARS=20000
# Max total size of attachments on an outgoing email
#EMAIL_MAX_ATTACHMENT_BYTES=20971520
# Folder names (auto-detected via IMAP special-use flags; these are fallbacks)
#SENT_FOLDER=Sent Messages
#TRASH_FOLDER=Deleted Messages

# ---- Local file access (attachments on disk) --------------------------------
# Default: enabled for stdio, disabled for HTTP. Force with true/false.
#ICLOUD_MCP_LOCAL_FILES=true
# Restrict attachment reads/writes to this directory
#ICLOUD_MCP_LOCAL_FILES_ROOT=/Users/me/Downloads

# ---- Tool surface -----------------------------------------------------------
# Tool groups to expose (comma separated): calendar, contacts, email (alias mail)
#ICLOUD_ENABLED_CATEGORIES=calendar,contacts,email
# Rich text in event notes/location and contact notes: markdown | text | raw
#ICLOUD_HTML_MODE=markdown
#DRAFTS_FOLDER=Drafts

# ---- HTTP transport ---------------------------------------------------------
# Shared secret required on every MCP request (Authorization: Bearer / X-MCP-Token).
# Without it the environment credentials above are NOT served over HTTP.
#MCP_AUTH_TOKEN=change-me-to-a-long-random-string
# Serve the environment account over HTTP even without MCP_AUTH_TOKEN (dangerous)
#ICLOUD_MCP_ALLOW_ENV_CREDENTIALS=false
#MCP_TRANSPORT=http          # same as --http (used by the Docker image)
#PORT=8000                   # Cloud Run sets this automatically
#MCP_SERVER_HOST=0.0.0.0
#MCP_SERVER_PATH=/mcp
#LOG_LEVEL=INFO

# ---- iCloud endpoints (rarely needed) ---------------------------------------
#CALDAV_SERVER=https://caldav.icloud.com
#CARDDAV_SERVER=https://contacts.icloud.com
#IMAP_SERVER=imap.mail.me.com
#SMTP_SERVER=smtp.mail.me.com
#IMAP_PORT=993
#SMTP_PORT=587
